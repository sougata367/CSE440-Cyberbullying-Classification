# Hugging Face access token with Inference Providers permission.
HF_TOKEN=hf_your_token_here

# Replace with the Hugging Face repo containing YOUR fine-tuned BERT model.
# Example: sougata367/cse440-cyberbullying-bert
HF_MODEL_ID=your-huggingface-username/cse440-cyberbullying-bert

# Default provider for text-classification inference.
HF_PROVIDER=hf-inference
